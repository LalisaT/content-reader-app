{
  "hosting": {
    "public": "dist-admin",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/careers",
        "destination": "/careers.html"
      },
      {
        "source": "/careers/**",
        "destination": "/careers.html"
      },
      {
        "source": "/jobs",
        "destination": "/careers.html"
      },
      {
        "source": "/jobs/**",
        "destination": "/careers.html"
      },
      {
        "source": "/tip",
        "destination": "/tip.html"
      },
      {
        "source": "/tip/**",
        "destination": "/tip.html"
      },
      {
        "source": "/article/**",
        "destination": "/tip.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
